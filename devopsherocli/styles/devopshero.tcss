/* DevOpsHeroCLI - Apple iOS 27 Sleek Dark Glassmorphism Theme */

Screen {
    background: #000000;
    color: #f2f2f7;
    layout: vertical;
    overflow-x: hidden;
}

/* Header Bar */
#header-bar {
    dock: top;
    height: 3;
    background: #111418;
    border-bottom: solid #22272e;
    padding: 0 1;
    layout: horizontal;
    align-vertical: middle;
    overflow-x: hidden;
}

.brand {
    width: 15;
    color: #5ac8fa;
    text-style: bold;
    content-align: left middle;
}

.level-box {
    width: 27;
    height: 3;
    layout: vertical;
    align-vertical: middle;
    padding: 0;
}

.level-title {
    color: #30d158;
    text-style: bold;
    height: 1;
}

.xp-bar-container {
    height: 1;
    background: #1c1c1e;
    color: #30d158;
}

.streak-box {
    width: auto;
    min-width: 15;
    height: 3;
    content-align: center middle;
    color: #ff9f0a;
    text-style: bold;
    background: #1c1c1e;
    border: round #ff453a;
    padding: 0 1;
    margin: 0;
}

.nav-actions {
    layout: horizontal;
    align: right middle;
    width: 1fr;
    overflow-x: hidden;
}

/* iOS 27 Solid Pill Capsule Action Buttons */
.action-btn {
    margin: 0 0 0 1;
    min-width: 9;
    height: 3;
    padding: 0;
    text-style: bold;
}

#btn-tracks {
    background: #007aff;
    border: round #5ac8fa;
    color: #ffffff;
}

#btn-tracks:hover {
    background: #0051a8;
    border: round #ffffff;
}

#btn-tip {
    background: #ff9500;
    border: round #ffd60a;
    color: #000000;
}

#btn-tip:hover {
    background: #c97700;
    color: #ffffff;
    border: round #ffffff;
}

#btn-solution {
    background: #ff3b30;
    border: round #ff6961;
    color: #ffffff;
}

#btn-solution:hover {
    background: #c41c14;
    border: round #ffffff;
}

#btn-reset {
    background: #3a3a3c;
    border: round #636366;
    color: #f2f2f7;
}

#btn-reset:hover {
    background: #48484a;
    border: round #ffffff;
}

/* Main Split View */
#main-container {
    height: 1fr;
    layout: horizontal;
    overflow-x: hidden;
}

/* Left Mission Panel */
#mission-panel {
    width: 42%;
    height: 100%;
    background: #0d1117;
    border-right: solid #22272e;
    padding: 0 1;
    overflow-y: auto;
    overflow-x: hidden;
}

.mission-track-badge {
    height: auto;
    color: #5ac8fa;
    text-style: bold;
    background: #1c1c1e;
    border: round #007aff;
    padding: 0 1;
    margin-top: 1;
    margin-bottom: 0;
    width: auto;
}

.mission-title {
    height: auto;
    color: #ffffff;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 0;
}

.meta-row {
    height: auto;
    layout: horizontal;
    margin-top: 1;
    margin-bottom: 1;
}

.badge-diff {
    height: auto;
    background: #14321d;
    border: round #30d158;
    color: #30d158;
    padding: 0 1;
    margin-right: 1;
    text-style: bold;
}

.badge-xp {
    height: auto;
    background: #0f243d;
    border: round #007aff;
    color: #5ac8fa;
    padding: 0 1;
    margin-right: 1;
    text-style: bold;
}

.badge-speed {
    height: auto;
    background: #2a1f00;
    border: round #ffd60a;
    color: #ffd60a;
    padding: 0 1;
    text-style: bold;
}

.section-label {
    height: auto;
    color: #8e8e93;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 0;
}

.context-box {
    height: auto;
    background: #14171d;
    border: round #2c313a;
    padding: 0 1;
    margin-bottom: 0;
    color: #ebebf5;
}

.objective-box {
    height: auto;
    background: #0d2318;
    border: round #30d158;
    padding: 0 1;
    margin-bottom: 0;
    color: #f2f2f7;
    text-style: bold;
}

.rules-box {
    height: auto;
    background: #1c1917;
    border: round #d97706;
    padding: 0 1;
    margin-bottom: 0;
    color: #e7e5e4;
}

.tip-box {
    height: auto;
    background: #2a1c0d;
    border: round #ff9f0a;
    padding: 0 1;
    margin-top: 1;
    margin-bottom: 0;
    color: #ffd60a;
}

.solution-box {
    height: auto;
    background: #2a0f12;
    border: round #ff453a;
    padding: 0 1;
    margin-top: 1;
    margin-bottom: 0;
    color: #ff6961;
}

/* Right Terminal Panel - iTerm2 Obsidian Acrylic */
#terminal-panel {
    width: 58%;
    height: 100%;
    background: #0d0f17;
    layout: vertical;
    overflow-x: hidden;
}

#term-title-bar {
    height: 3;
    background: #141721;
    border-bottom: solid #212532;
    padding: 0 1;
    layout: horizontal;
    align-vertical: middle;
    overflow-x: hidden;
}

.term-dots {
    width: 9;
    color: #ff5f56;
}

.iterm-tab-active {
    width: auto;
    height: 100%;
    background: #1e2230;
    border-top: solid #5ac8fa;
    border-left: solid #2a2e40;
    border-right: solid #2a2e40;
    padding: 0 2;
    content-align: center middle;
    align: center middle;
}

.iterm-tab-title {
    color: #e5e9f0;
    text-style: bold;
}

.term-bar-spacer {
    width: 1fr;
}

.term-status-badge {
    width: auto;
    color: #5af78e;
    text-style: bold;
    content-align: right middle;
}

#term-output-log {
    height: 1fr;
    background: #0d0f17;
    color: #f8f8f2;
    padding: 0 1;
    overflow-y: auto;
    overflow-x: hidden;
}

#term-input-container {
    height: 3;
    background: #0d0f17;
    border-top: solid #1f2332;
    layout: horizontal;
    align-vertical: middle;
    padding: 0 1;
    overflow-x: hidden;
}

#term-prompt {
    width: auto;
    color: #5af78e;
    text-style: bold;
    padding: 0 1 0 0;
    background: #0d0f17;
}

#term-input {
    width: 1fr;
    background: #0d0f17;
    border: none;
    color: #f8f8f2;
    padding: 0;
}

#term-input:focus {
    border: none;
    background: #0d0f17;
}

/* Footer Shortcuts */
#footer-bar {
    dock: bottom;
    height: 1;
    background: #111418;
    color: #8e8e93;
    border-top: solid #22272e;
    padding: 0 1;
    content-align: center middle;
    overflow-x: hidden;
}

/* Tracks Modal Dialog */
TracksModal {
    align: center middle;
    background: rgba(0, 0, 0, 0.85);
}

#tracks-dialog {
    width: 82%;
    height: 82%;
    background: #111418;
    border: round #007aff;
    padding: 1 2;
    layout: vertical;
}

#tracks-list {
    height: 1fr;
    overflow-y: scroll;
    overflow-x: hidden;
    margin-top: 1;
    margin-bottom: 1;
}

.track-modal-header {
    color: #5ac8fa;
    text-style: bold;
}

.track-group-title {
    color: #ff9f0a;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 0;
}

.mission-item-btn {
    margin: 0 0 1 0;
    width: 100%;
    height: 3;
    background: #1c1c1e;
    border: round #3a3a3c;
    color: #ebebf5;
    text-align: left;
}

.mission-item-btn:hover {
    background: #2c2c2e;
    border: round #007aff;
    color: #ffffff;
}

.mission-item-done {
    background: #14321d;
    border: round #30d158;
    color: #30d158;
}

.mission-item-curr {
    background: #007aff;
    border: round #5ac8fa;
    color: #ffffff;
    text-style: bold;
}

#btn-close-modal {
    width: 100%;
    height: 3;
    background: #ff3b30;
    border: round #ff6961;
    color: #ffffff;
    text-style: bold;
}

#btn-close-modal:hover {
    background: #c41c14;
    color: #ffffff;
}
