/* ==========================================================================
   DevOpsHeroCLI - Modular Multi-Pane Architecture & Design Language
   Character-box layout with border-titles and deep obsidian theme
   ========================================================================== */

Screen {
    background: #0f111a;
    color: #f8fafc;
    layout: vertical;
    overflow-x: hidden;
}

#dh-root {
    width: 100%;
    height: 1fr;
    layout: horizontal;
    background: #0f111a;
    overflow-x: hidden;
    padding: 0 1;
}

/* ==========================================================================
   1. Left Sidebar Navigation
   ========================================================================== */
#dh-sidebar {
    width: 25;
    height: 100%;
    background: #0f111a;
    border: round #fb7185;
    border-title-align: left;
    border-subtitle-align: right;
    layout: vertical;
    padding: 0;
    margin-right: 1;
}

#dh-sidebar:focus {
    border: round #ff7b92;
}

#sidebar-scroll {
    height: 1fr;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 0 1;
}

.sidebar-category {
    color: #fb7185;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 0;
    height: 1;
}

.sidebar-subcat {
    color: #64748b;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 0;
    height: 1;
}

.sidebar-nav-item,
.sidebar-nav-btn {
    width: 100%;
    height: 1;
    min-height: 1;
    background: transparent;
    border: none;
    color: #94a3b8;
    content-align: left middle;
    padding: 0 1;
    margin: 0;
}

.sidebar-nav-item:hover,
.sidebar-nav-btn:hover {
    background: #1e243e;
    color: #ffffff;
}

.sidebar-active {
    background: #1a233a;
    color: #00f2fe;
    text-style: bold;
}

.sidebar-cursor {
    background: #273559;
    color: #ffffff;
    text-style: bold;
}

.sidebar-disabled {
    color: #475569;
}

.sidebar-disk-label {
    color: #64748b;
    padding: 0 1;
    height: 1;
}

#sidebar-footer {
    height: 3;
    background: #0f111a;
    border-top: round #272e4f;
    layout: horizontal;
    align-vertical: middle;
    padding: 0 1;
}

.sidebar-footer-text {
    width: 1fr;
    color: #64748b;
    text-style: bold;
}

.sidebar-footer-collapse {
    width: auto;
    color: #64748b;
}

/* ==========================================================================
   2. Main Column (Top Header + Dynamic View Container)
   ========================================================================== */
#dh-main-col {
    width: 1fr;
    height: 100%;
    layout: vertical;
    background: #0f111a;
}

/* Top Header Bar (Zero Broken Pills) */
#dh-top-header {
    dock: top;
    height: 3;
    background: #0f111a;
    border: round #272e4f;
    border-title-align: left;
    border-subtitle-align: right;
    layout: horizontal;
    align-vertical: middle;
    padding: 0 1;
    margin-bottom: 1;
}

#top-title-col {
    width: auto;
    layout: horizontal;
    align-vertical: middle;
}

#top-header-icon {
    width: 2;
    color: #38bdf8;
    margin-right: 1;
}

.top-brand-title {
    color: #38bdf8;
    text-style: bold;
}

.top-sep {
    color: #334155;
    margin: 0 1;
}

.top-main-title {
    color: #f8fafc;
    text-style: bold;
}

.top-track-title {
    color: #9e85ff;
    text-style: bold;
}

#top-status-col {
    width: 1fr;
    layout: horizontal;
    align: right middle;
}

#lbl-top-status {
    color: #94a3b8;
}

.top-update-badge {
    display: none;
    color: #fb7185;
    text-style: bold;
    margin-left: 2;
}

/* Dynamic Views Container */
#dh-views-container {
    height: 1fr;
    overflow-y: auto;
    overflow-x: hidden;
}

/* ==========================================================================
   3. Console Home View (Dashboard Layout)
   ========================================================================== */
#view-console-home {
    width: 100%;
    height: auto;
    layout: vertical;
    padding: 0 1;
}

/* Selected Runtime Hero Banner Card */
#hero-banner-card {
    width: 100%;
    height: auto;
    background: #131728;
    border: round #10b981;
    border-title-align: left;
    border-subtitle-align: right;
    padding: 1 2;
    margin-bottom: 1;
}

#hero-header-row {
    width: 100%;
    height: auto;
    layout: horizontal;
    align-vertical: middle;
}

#hero-text-col {
    width: 1fr;
    layout: vertical;
}

.hero-tag-label {
    color: #10b981;
    text-style: bold;
    height: 1;
}

.hero-main-title {
    color: #f8fafc;
    text-style: bold;
    height: 1;
}

.hero-desc {
    color: #94a3b8;
    height: auto;
    margin-top: 1;
}

.hero-action-btn {
    width: auto;
    min-width: 0;
    height: 3;
    background: #272e4f;
    border: round #10b981;
    color: #ffffff;
    text-style: bold;
    padding: 0 2;
    content-align: center middle;
    align: center middle;
}

.hero-action-btn:hover {
    background: #10b981;
    color: #0b0e1b;
}

/* Runtime Status Summary Bar (4 Cards) */
#dh-metrics-row {
    width: 100%;
    height: auto;
    layout: horizontal;
    margin-bottom: 1;
}

.dh-stat-card {
    width: 1fr;
    height: 5;
    background: #131728;
    border: round #272e4f;
    border-title-align: left;
    border-subtitle-align: right;
    padding: 0 1;
    margin-right: 1;
}

.dh-stat-card:last-of-type {
    margin-right: 0;
}

.stat-card-label {
    color: #64748b;
    text-style: bold;
    height: 1;
    margin-top: 0;
}

.stat-card-val {
    color: #f8fafc;
    text-style: bold;
    height: 1;
}

.stat-val-green {
    color: #10b981;
}

.stat-card-sub {
    color: #64748b;
    height: 1;
}

/* Micro Status Chips Row */
#dh-chips-row {
    width: 100%;
    height: auto;
    layout: horizontal;
    margin-bottom: 1;
}

.dh-chip {
    width: auto;
    height: 1;
    background: #131728;
    border: round #272e4f;
    color: #9e85ff;
    padding: 0 1;
    margin-right: 1;
    text-style: bold;
}

/* 4x2 Grid of Service Cards */
#dh-grid-container {
    width: 100%;
    height: auto;
    layout: vertical;
}

.dh-grid-row {
    width: 100%;
    height: auto;
    layout: horizontal;
    margin-bottom: 1;
}

.service-card {
    width: 1fr;
    height: 7;
    background: #131728;
    border: round #272e4f;
    border-title-align: left;
    border-subtitle-align: right;
    padding: 1 1;
    margin-right: 1;
    color: #f8fafc;
    content-align: left top;
}

.service-card:last-of-type {
    margin-right: 0;
}

.service-card:hover {
    background: #1e243e;
    border: round #9e85ff;
}

.service-card-disabled {
    opacity: 0.6;
    border: round #1c223a;
}

/* ==========================================================================
   4. Terminal Lab View (Multi-Pane Architecture)
   Top: Missions Browser Column + Code/Terminal Column
   Bottom: Tri-Panel Tray (Processes, Metadata, Clipboard)
   ========================================================================== */
#view-terminal-lab {
    width: 100%;
    height: 100%;
    layout: vertical;
}

/* Top Area: Workspace Columns (~68% height) */
#lab-workspace {
    width: 100%;
    height: 68%;
    layout: horizontal;
    margin-bottom: 1;
}

/* Column 1: Missions Directory Browser (Directory Pane) */
#mission-panel {
    width: 32%;
    height: 100%;
    background: #0f111a;
    border: round #9e85ff;
    border-title-align: left;
    border-subtitle-align: right;
    layout: vertical;
    padding: 0 1;
    margin-right: 1;
}

#mission-panel:focus {
    border: round #00f2fe;
}

#mission-search-row {
    height: 1;
    border-bottom: solid #272e4f;
    margin-bottom: 1;
}

#lbl-mission-search {
    color: #64748b;
    text-style: italic;
}

#missions-tree-scroll {
    height: 1fr;
    overflow-y: auto;
    overflow-x: hidden;
}

#box-missions-list {
    height: auto;
    layout: vertical;
}

.mission-file-item,
.mission-file-btn {
    width: 100%;
    height: 1;
    min-height: 1;
    background: transparent;
    border: none;
    color: #94a3b8;
    content-align: left middle;
    padding: 0;
    margin: 0;
}

.mission-file-item:hover,
.mission-file-btn:hover {
    background: #1e243e;
    color: #ffffff;
}

.mission-file-active {
    color: #00f2fe;
    background: #161f36;
    text-style: bold;
}

.mission-file-cursor {
    background: #1e294b;
    color: #ffffff;
    text-style: bold;
}

.mission-file-done {
    color: #10b981;
}

.mission-file-locked {
    color: #64748b;
}

#mission-panel-meta-hidden {
    display: none;
}

.mission-track-badge {
    height: auto;
    color: #9e85ff;
    text-style: bold;
}

.mission-title {
    height: auto;
    color: #ffffff;
    text-style: bold;
}

.meta-row {
    height: auto;
    layout: horizontal;
}

.badge-diff {
    height: auto;
    background: #0d281e;
    border: round #10b981;
    color: #10b981;
    padding: 0 1;
    margin-right: 1;
    text-style: bold;
}

.badge-xp {
    height: auto;
    background: #1d1b38;
    border: round #9e85ff;
    color: #9e85ff;
    padding: 0 1;
    margin-right: 1;
    text-style: bold;
}

.badge-speed {
    height: auto;
    background: #29200e;
    border: round #fbbf24;
    color: #fbbf24;
    padding: 0 1;
    text-style: bold;
}

.section-label {
    height: auto;
    color: #64748b;
    text-style: bold;
}

/* Column 2: Code Preview & Interactive Terminal Window */
#terminal-panel {
    width: 1fr;
    height: 100%;
    background: #0f111a;
    border: round #38bdf8;
    border-title-align: left;
    border-subtitle-align: right;
    layout: vertical;
    padding: 0;
}

#terminal-panel:focus-within {
    border: round #00f2fe;
}

#term-title-bar {
    height: 1;
    background: #131728;
    padding: 0 1;
    layout: horizontal;
    align-vertical: middle;
}

.term-dots {
    width: 8;
}

.term-tab-active {
    width: auto;
    height: 1;
    background: transparent;
    padding: 0 1;
}

.term-tab-title {
    color: #38bdf8;
    text-style: bold;
}

.term-bar-spacer {
    width: 1fr;
}

.term-status-badge {
    width: auto;
    color: #10b981;
    text-style: bold;
}

#term-output-log {
    height: 1fr;
    background: #0f111a;
    color: #f8fafc;
    padding: 0 1;
    overflow-y: auto;
    overflow-x: hidden;
}

#term-input-container {
    height: 2;
    background: #131728;
    border-top: solid #272e4f;
    layout: horizontal;
    align-vertical: middle;
    padding: 0 1;
}

#term-prompt {
    width: auto;
    color: #10b981;
    text-style: bold;
}

#term-input {
    width: 1fr;
    background: transparent;
    border: none;
    color: #f8fafc;
    padding: 0;
}

#term-input:focus {
    border: none;
    background: transparent;
}

Input > .input--cursor,
#term-input > .input--cursor {
    background: transparent;
    color: #00f2fe;
    text-style: underline bold;
}

Input > .input--placeholder,
#term-input > .input--placeholder {
    color: #64748b;
}

/* ==========================================================================
   5. Bottom Tri-Panel Tray (Processes, Metadata, Clipboard) (~32% height)
   ========================================================================== */
#lab-bottom-tray {
    width: 100%;
    height: 32%;
    layout: horizontal;
}

.tray-panel {
    height: 100%;
    background: #0f111a;
    border: round #272e4f;
    border-title-align: left;
    border-subtitle-align: right;
    padding: 0 1;
}

#panel-processes {
    width: 32%;
    margin-right: 1;
}

#panel-processes:focus {
    border: round #10b981;
}

#panel-metadata {
    width: 38%;
    margin-right: 1;
}

#panel-metadata:focus {
    border: round #9e85ff;
}

#panel-clipboard {
    width: 30%;
}

#panel-clipboard:focus {
    border: round #fb7185;
}

.shortcuts-box {
    height: auto;
    color: #cbd5e1;
    margin-bottom: 1;
}

.tray-header-label {
    color: #64748b;
    text-style: bold;
    height: 1;
    margin-bottom: 0;
}

.metadata-content-box {
    height: auto;
    color: #cbd5e1;
    margin-bottom: 0;
}

.context-box {
    height: auto;
    color: #94a3b8;
    margin-top: 0;
}

.objective-box {
    height: auto;
    color: #ffffff;
    text-style: bold;
    margin-top: 0;
}

.rules-box {
    height: auto;
    color: #94a3b8;
    margin-bottom: 0;
}

#lab-xp-bar {
    width: 100%;
    height: 1;
    margin-top: 1;
}

.lab-quick-actions {
    layout: horizontal;
    height: 2;
    margin-bottom: 1;
}

.action-btn {
    width: auto;
    min-width: 0;
    height: 2;
    padding: 0 1;
    margin-right: 1;
    text-style: bold;
}

#btn-tip {
    background: #272e4f;
    border: round #fbbf24;
    color: #fbbf24;
}

#btn-tip:hover {
    background: #3a3219;
    color: #ffffff;
}

#btn-solution {
    background: #272e4f;
    border: round #fb7185;
    color: #fb7185;
}

#btn-solution:hover {
    background: #3d1b26;
    color: #ffffff;
}

#btn-reset {
    background: #272e4f;
    border: round #475569;
    color: #cbd5e1;
}

#btn-reset:hover {
    background: #334155;
    color: #ffffff;
}

#btn-tracks {
    background: #272e4f;
    border: round #9e85ff;
    color: #9e85ff;
}

#btn-tracks:hover {
    background: #3e326e;
    color: #ffffff;
}

.tip-box {
    height: auto;
    background: #252014;
    border: round #fbbf24;
    padding: 0 1;
    color: #fde68a;
}

.solution-box {
    height: auto;
    background: #29151c;
    border: round #fb7185;
    padding: 0 1;
    color: #fecdd3;
}

/* ==========================================================================
   6. Footer Shortcuts Bar
   ========================================================================== */
#footer-bar {
    dock: bottom;
    height: 1;
    background: #0f111a;
    color: #64748b;
    border-top: solid #272e4f;
    padding: 0 1;
    content-align: center middle;
    overflow-x: hidden;
}

/* ==========================================================================
   7. Modals (TracksModal & AppUpdateModal)
   ========================================================================== */
TracksModal {
    align: center middle;
    background: rgba(15, 17, 26, 0.88);
}

#tracks-dialog {
    width: 82%;
    height: 82%;
    background: #0f111a;
    border: round #9e85ff;
    border-title-align: left;
    border-subtitle-align: right;
    padding: 1 2;
    layout: vertical;
}

#tracks-list {
    height: 1fr;
    overflow-y: scroll;
    overflow-x: hidden;
    margin-top: 1;
    margin-bottom: 1;
}

.track-modal-header {
    color: #9e85ff;
    text-style: bold;
}

.track-modal-sub {
    color: #94a3b8;
    margin-bottom: 1;
}

.track-card-btn {
    margin: 0 0 1 0;
    width: 100%;
    height: 5;
    background: #131728;
    border: round #272e4f;
    color: #e2e8f0;
    text-align: left;
    padding: 0 1;
}

.track-card-btn:hover {
    background: #1e243e;
    border: round #9e85ff;
    color: #ffffff;
}

.track-card-curr {
    background: #1e243e;
    border: round #9e85ff;
    color: #ffffff;
}

.track-card-progress {
    background: #1e243e;
    border: round #9e85ff;
    color: #ffffff;
}

.track-card-done {
    background: #0d281e;
    border: round #10b981;
    color: #ffffff;
}

.track-card-locked {
    background: #101320;
    border: round #1f253d;
    color: #64748b;
}

#btn-close-modal {
    margin-top: 1;
    background: #272e4f;
    border: round #9e85ff;
    color: #ffffff;
}

#btn-close-modal:hover {
    background: #9e85ff;
    color: #0b0e1b;
}

/* App Update Modal */
AppUpdateModal {
    align: center middle;
    background: rgba(15, 17, 26, 0.88);
}

#update-card {
    width: 64;
    height: auto;
    max-height: 85%;
    background: #0f111a;
    border: round #9e85ff;
    border-title-align: left;
    border-subtitle-align: right;
    padding: 1 2;
    layout: vertical;
}

#update-top-row {
    height: 4;
    layout: horizontal;
    align-vertical: middle;
}

#update-icon-box {
    width: 5;
    height: 3;
    content-align: center middle;
    color: #9e85ff;
}

#update-title-col {
    width: 1fr;
    layout: vertical;
}

#update-title-row {
    height: 1;
    layout: horizontal;
}

.update-app-title {
    color: #ffffff;
    text-style: bold;
    margin-right: 1;
}

.update-by-author {
    color: #64748b;
    margin-right: 1;
}

.update-pill-badge {
    background: #9e85ff;
    color: #0b0e1b;
    text-style: bold;
    padding: 0 1;
}

.update-version-label {
    color: #94a3b8;
    margin-top: 1;
}

#btn-update-close {
    width: 4;
    height: 3;
    background: transparent;
    border: none;
    color: #64748b;
}

#btn-update-close:hover {
    color: #ffffff;
}

#update-progress-row {
    height: auto;
    margin-top: 1;
    margin-bottom: 1;
}

.update-status-line {
    height: 1;
    layout: horizontal;
    margin-bottom: 1;
}

#lbl-update-spinner {
    width: 2;
    color: #9e85ff;
}

.update-status-msg {
    color: #94a3b8;
}

#update-progress-bar {
    height: 1;
    background: #272e4f;
    color: #9e85ff;
}

#update-whats-new-box {
    height: auto;
    max-height: 12;
    background: #131728;
    border: round #272e4f;
    padding: 1 1;
    margin-top: 1;
    margin-bottom: 1;
    overflow-y: auto;
}

.whats-new-heading {
    color: #9e85ff;
    text-style: bold;
}

.whats-new-item {
    color: #cbd5e1;
    margin-bottom: 1;
}

#update-divider-line {
    height: 1;
    border-bottom: solid #272e4f;
    margin-bottom: 1;
}

#update-footer-row {
    height: 3;
    layout: horizontal;
    align-vertical: middle;
}

#btn-whats-new {
    width: auto;
    background: transparent;
    border: none;
    color: #9e85ff;
}

#btn-whats-new:hover {
    color: #ffffff;
}

#btn-update-dismiss {
    width: auto;
    background: #272e4f;
    border: round #9e85ff;
    color: #ffffff;
    text-style: bold;
    margin-left: 2;
}

#btn-update-dismiss:hover {
    background: #9e85ff;
    color: #0b0e1b;
}
