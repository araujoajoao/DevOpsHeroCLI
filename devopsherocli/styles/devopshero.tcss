/* ==========================================================================
   DevOpsHeroCLI - Flocí Cloud Console Architecture & Theme
   Authentic replica of Flocí Local Cloud Runtime Console UI
   ========================================================================== */

Screen {
    background: #131627;
    color: #f8fafc;
    layout: vertical;
    overflow-x: hidden;
}

/* ==========================================================================
   Root Layout: Left Sidebar + Main Content Area
   ========================================================================== */
#floci-root {
    width: 100%;
    height: 1fr;
    layout: horizontal;
    background: #131627;
    overflow-x: hidden;
}

/* ==========================================================================
   1. Left Sidebar Navigation (Authentic Flocí Console Sidebar)
   ========================================================================== */
#floci-sidebar {
    width: 25;
    height: 100%;
    background: #0f1220;
    border-right: solid #272e4f;
    layout: vertical;
    padding: 0;
}

#sidebar-scroll {
    height: 1fr;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 0 1;
}

.sidebar-category {
    color: #64748b;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 0;
    height: 1;
}

.sidebar-subcat {
    color: #475569;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 0;
    height: 1;
}

.sidebar-nav-btn {
    width: 100%;
    height: 2;
    min-height: 2;
    background: transparent;
    border: none;
    color: #94a3b8;
    content-align: left middle;
    padding: 0 1;
    margin: 0;
}

.sidebar-nav-btn:hover {
    background: #1e243e;
    color: #ffffff;
}

.sidebar-active {
    background: #272e4f;
    color: #9e85ff;
    border-left: wide #9e85ff;
    text-style: bold;
}

.sidebar-disabled {
    color: #475569;
}

#sidebar-footer {
    height: 3;
    background: #0f1220;
    border-top: solid #272e4f;
    layout: horizontal;
    align-vertical: middle;
    padding: 0 1;
}

.sidebar-footer-text {
    width: 1fr;
    color: #64748b;
    text-style: bold;
}

.sidebar-footer-collapse {
    width: auto;
    color: #64748b;
}

/* ==========================================================================
   2. Main Column (Top Bar + Dynamic View Container)
   ========================================================================== */
#floci-main-col {
    width: 1fr;
    height: 100%;
    layout: vertical;
    background: #131627;
}

/* Top Header Bar */
#floci-top-header {
    dock: top;
    height: 3;
    background: #181d33;
    border-bottom: solid #272e4f;
    layout: horizontal;
    align-vertical: middle;
    padding: 0 2;
}

#top-title-col {
    width: auto;
    layout: horizontal;
    align-vertical: middle;
}

#top-header-icon {
    width: 3;
    height: 1;
    color: #9e85ff;
    margin-right: 1;
}

#top-header-text-col {
    width: auto;
    layout: horizontal;
    align-vertical: middle;
}

.top-main-title {
    color: #f8fafc;
    text-style: bold;
    margin-right: 2;
}

.top-sub-title {
    color: #64748b;
}

#top-pills-row {
    width: 1fr;
    layout: horizontal;
    align: right middle;
    height: 3;
}

.top-filter-pill {
    width: auto;
    min-width: 0;
    height: 2;
    background: #1e243e;
    border: solid #272e4f;
    color: #a5b4fc;
    padding: 0 1;
    margin-left: 1;
    text-style: bold;
}

.top-filter-pill:hover {
    background: #272e4f;
    border: solid #9e85ff;
    color: #ffffff;
}

.top-update-pill {
    display: none;
    width: auto;
    min-width: 0;
    height: 2;
    background: #272e4f;
    border: solid #fb7185;
    color: #fb7185;
    padding: 0 1;
    margin-left: 1;
    text-style: bold;
}

/* Dynamic Views Container */
#floci-views-container {
    height: 1fr;
    overflow-y: auto;
    overflow-x: hidden;
}

/* ==========================================================================
   3. Flocí Console Home View (Dashboard Layout from Screenshot)
   ========================================================================== */
#view-console-home {
    width: 100%;
    height: auto;
    layout: vertical;
    padding: 1 2;
}

/* Selected Runtime Hero Banner Card */
#hero-banner-card {
    width: 100%;
    height: auto;
    background: #1e243e;
    border: solid #272e4f;
    border-left: wide #10b981; /* Emerald green left accent line */
    padding: 1 2;
    margin-bottom: 1;
}

#hero-header-row {
    width: 100%;
    height: auto;
    layout: horizontal;
    align-vertical: middle;
}

#hero-text-col {
    width: 1fr;
    layout: vertical;
}

.hero-tag-label {
    color: #10b981;
    text-style: bold;
    height: 1;
}

.hero-main-title {
    color: #f8fafc;
    text-style: bold;
    height: 1;
}

.hero-desc {
    color: #94a3b8;
    height: auto;
    margin-top: 1;
}

.hero-action-btn {
    width: auto;
    min-width: 0;
    height: 3;
    background: #272e4f;
    border: solid #9e85ff;
    color: #ffffff;
    text-style: bold;
    padding: 0 2;
    content-align: center middle;
    align: center middle;
}

.hero-action-btn:hover {
    background: #9e85ff;
    color: #0b0e1b;
}

/* Runtime Status Summary Bar (4 Cards) */
#floci-metrics-row {
    width: 100%;
    height: auto;
    layout: horizontal;
    margin-bottom: 1;
}

.floci-stat-card {
    width: 1fr;
    height: 5;
    background: #1e243e;
    border: solid #272e4f;
    padding: 0 1;
    margin-right: 1;
}

.floci-stat-card:last-of-type {
    margin-right: 0;
}

.stat-card-label {
    color: #64748b;
    text-style: bold;
    height: 1;
    margin-top: 0;
}

.stat-card-val {
    color: #f8fafc;
    text-style: bold;
    height: 1;
}

.stat-val-green {
    color: #10b981;
}

.stat-card-sub {
    color: #64748b;
    height: 1;
}

/* Micro Status Chips Row */
#floci-chips-row {
    width: 100%;
    height: auto;
    layout: horizontal;
    margin-bottom: 1;
}

.floci-chip {
    width: auto;
    height: 1;
    background: #161b2e;
    border: solid #272e4f;
    color: #9e85ff;
    padding: 0 1;
    margin-right: 1;
    text-style: bold;
}

/* 4x2 Grid of Service Cards (Flocí Service Cards) */
#floci-grid-container {
    width: 100%;
    height: auto;
    layout: vertical;
}

.floci-grid-row {
    width: 100%;
    height: auto;
    layout: horizontal;
    margin-bottom: 1;
}

.service-card {
    width: 1fr;
    height: 7;
    background: #1e243e;
    border: solid #272e4f;
    padding: 1 1;
    margin-right: 1;
    color: #f8fafc;
    content-align: left top;
}

.service-card:last-of-type {
    margin-right: 0;
}

.service-card:hover {
    background: #272e4f;
    border: solid #9e85ff;
}

.service-card-disabled {
    opacity: 0.6;
    border: solid #1c223a;
}

/* ==========================================================================
   4. Terminal Lab View (Split into Mission Briefing & Oh My Zsh Terminal)
   ========================================================================== */
#view-terminal-lab {
    width: 100%;
    height: 100%;
    layout: horizontal;
    overflow-x: hidden;
}

/* Left Mission Briefing Panel */
#mission-panel {
    width: 40%;
    height: 100%;
    background: #161b2e;
    border-right: solid #272e4f;
    padding: 0 1;
    overflow-y: auto;
    overflow-x: hidden;
}

.mission-track-badge {
    height: auto;
    color: #9e85ff;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 0;
}

.mission-title {
    height: auto;
    color: #ffffff;
    text-style: bold;
    margin-top: 0;
    margin-bottom: 0;
}

.meta-row {
    height: auto;
    layout: horizontal;
    margin-top: 1;
    margin-bottom: 1;
}

.badge-diff {
    height: auto;
    background: #0d281e;
    border: round #10b981;
    color: #10b981;
    padding: 0 1;
    margin-right: 1;
    text-style: bold;
}

.badge-xp {
    height: auto;
    background: #1d1b38;
    border: round #9e85ff;
    color: #9e85ff;
    padding: 0 1;
    margin-right: 1;
    text-style: bold;
}

.badge-speed {
    height: auto;
    background: #29200e;
    border: round #fbbf24;
    color: #fbbf24;
    padding: 0 1;
    text-style: bold;
}

.section-label {
    height: auto;
    color: #64748b;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 0;
}

.context-box {
    height: auto;
    background: #1e243e;
    border: solid #272e4f;
    padding: 0 1;
    color: #cbd5e1;
    margin-bottom: 0;
}

.objective-box {
    height: auto;
    background: #1e243e;
    border: round #9e85ff;
    padding: 0 1;
    color: #ffffff;
    text-style: bold;
    margin-bottom: 0;
}

.rules-box {
    height: auto;
    background: #1e243e;
    border: solid #272e4f;
    padding: 0 1;
    color: #94a3b8;
    margin-bottom: 1;
}

.lab-quick-actions {
    layout: horizontal;
    height: auto;
    margin-top: 1;
    margin-bottom: 1;
}

.action-btn {
    width: auto;
    min-width: 0;
    height: 3;
    padding: 0 1;
    margin-right: 1;
    text-style: bold;
    content-align: center middle;
    align: center middle;
}

#btn-tip {
    background: #272e4f;
    border: round #fbbf24;
    color: #fbbf24;
}

#btn-tip:hover {
    background: #3a3219;
    border: round #fbbf24;
    color: #ffffff;
}

#btn-solution {
    background: #272e4f;
    border: round #fb7185;
    color: #fb7185;
}

#btn-solution:hover {
    background: #3d1b26;
    border: round #fb7185;
    color: #ffffff;
}

#btn-reset {
    background: #272e4f;
    border: round #475569;
    color: #cbd5e1;
}

#btn-reset:hover {
    background: #334155;
    border: round #94a3b8;
    color: #ffffff;
}

#btn-tracks {
    background: #272e4f;
    border: round #9e85ff;
    color: #9e85ff;
}

#btn-tracks:hover {
    background: #3e326e;
    border: round #9e85ff;
    color: #ffffff;
}

.tip-box {
    height: auto;
    background: #252014;
    border: round #fbbf24;
    padding: 0 1;
    margin-top: 1;
    margin-bottom: 0;
    color: #fde68a;
}

.solution-box {
    height: auto;
    background: #29151c;
    border: round #fb7185;
    padding: 0 1;
    margin-top: 1;
    margin-bottom: 0;
    color: #fecdd3;
}

/* Right Terminal Window (iTerm2 Oh My Zsh) */
#terminal-panel {
    width: 60%;
    height: 100%;
    background: #1e243e;
    layout: vertical;
    overflow-x: hidden;
}

#term-title-bar {
    height: 3;
    background: #181d33;
    border-bottom: solid #272e4f;
    padding: 0 1;
    layout: horizontal;
    align-vertical: middle;
    overflow-x: hidden;
}

.term-dots {
    width: 8;
}

.iterm-tab-active {
    width: auto;
    height: 100%;
    background: #1e243e;
    border-top: solid #9e85ff;
    border-left: solid #272e4f;
    border-right: solid #272e4f;
    padding: 0 2;
    content-align: center middle;
    align: center middle;
}

.iterm-tab-title {
    color: #a5b4fc;
    text-style: bold;
}

.term-bar-spacer {
    width: 1fr;
}

.term-status-badge {
    width: auto;
    color: #10b981;
    text-style: bold;
    content-align: right middle;
}

#term-output-log {
    height: 1fr;
    background: #1e243e;
    color: #f8fafc;
    padding: 0 1;
    overflow-y: auto;
    overflow-x: hidden;
}

#term-input-container {
    height: 3;
    background: #181d33;
    border-top: solid #272e4f;
    layout: horizontal;
    align-vertical: middle;
    padding: 0 1;
    overflow-x: hidden;
}

#term-prompt {
    width: auto;
    color: #10b981;
    text-style: bold;
    padding: 0 1 0 0;
    background: #181d33;
}

#term-input {
    width: 1fr;
    background: #181d33;
    border: none;
    color: #f8fafc;
    padding: 0;
}

#term-input:focus {
    border: none;
    background: #181d33;
}

Input > .input--cursor,
#term-input > .input--cursor {
    background: transparent;
    color: #00f2fe;
    text-style: underline bold;
}

Input > .input--placeholder,
#term-input > .input--placeholder {
    color: #64748b;
}

/* ==========================================================================
   5. Footer Shortcuts Bar
   ========================================================================== */
#footer-bar {
    dock: bottom;
    height: 1;
    background: #0f1220;
    color: #64748b;
    border-top: solid #272e4f;
    padding: 0 1;
    content-align: center middle;
    overflow-x: hidden;
}

/* ==========================================================================
   6. Modals (TracksModal & AppUpdateModal)
   ========================================================================== */
TracksModal {
    align: center middle;
    background: rgba(19, 22, 39, 0.88);
}

#tracks-dialog {
    width: 82%;
    height: 82%;
    background: #161b2e;
    border: round #9e85ff;
    padding: 1 2;
    layout: vertical;
}

#tracks-list {
    height: 1fr;
    overflow-y: scroll;
    overflow-x: hidden;
    margin-top: 1;
    margin-bottom: 1;
}

.track-modal-header {
    color: #9e85ff;
    text-style: bold;
}

.track-modal-sub {
    color: #94a3b8;
    margin-bottom: 1;
}

.track-card-btn {
    margin: 0 0 1 0;
    width: 100%;
    height: 5;
    background: #1e243e;
    border: round #272e4f;
    color: #e2e8f0;
    text-align: left;
    padding: 0 1;
}

.track-card-btn:hover {
    background: #272e4f;
    border: round #9e85ff;
    color: #ffffff;
}

.track-card-curr {
    background: #272e4f;
    border: round #9e85ff;
    color: #ffffff;
}

.track-card-progress {
    background: #23223f;
    border: round #9e85ff;
    color: #ffffff;
}

.track-card-done {
    background: #0d281e;
    border: round #10b981;
    color: #ffffff;
}

.track-card-locked {
    background: #141829;
    border: round #1f253d;
    color: #64748b;
}

#btn-close-modal {
    margin-top: 1;
    background: #272e4f;
    border: round #9e85ff;
    color: #ffffff;
}

#btn-close-modal:hover {
    background: #9e85ff;
    color: #0b0e1b;
}

/* App Update Modal */
AppUpdateModal {
    align: center middle;
    background: rgba(19, 22, 39, 0.88);
}

#update-card {
    width: 64;
    height: auto;
    max-height: 85%;
    background: #161b2e;
    border: round #9e85ff;
    padding: 1 2;
    layout: vertical;
}

#update-top-row {
    height: 4;
    layout: horizontal;
    align-vertical: middle;
}

#update-icon-box {
    width: 5;
    height: 3;
    content-align: center middle;
    color: #9e85ff;
}

#update-title-col {
    width: 1fr;
    layout: vertical;
}

#update-title-row {
    height: 1;
    layout: horizontal;
}

.update-app-title {
    color: #ffffff;
    text-style: bold;
    margin-right: 1;
}

.update-by-author {
    color: #64748b;
    margin-right: 1;
}

.update-pill-badge {
    background: #9e85ff;
    color: #0b0e1b;
    text-style: bold;
    padding: 0 1;
}

.update-version-label {
    color: #94a3b8;
    margin-top: 1;
}

#btn-update-close {
    width: 4;
    height: 3;
    background: transparent;
    border: none;
    color: #64748b;
}

#btn-update-close:hover {
    color: #ffffff;
}

#update-progress-row {
    height: auto;
    margin-top: 1;
    margin-bottom: 1;
}

.update-status-line {
    height: 1;
    layout: horizontal;
    margin-bottom: 1;
}

#lbl-update-spinner {
    width: 2;
    color: #9e85ff;
}

.update-status-msg {
    color: #94a3b8;
}

#update-progress-bar {
    height: 1;
    background: #272e4f;
    color: #9e85ff;
}

#update-whats-new-box {
    height: auto;
    max-height: 12;
    background: #131627;
    border: solid #272e4f;
    padding: 1 1;
    margin-top: 1;
    margin-bottom: 1;
    overflow-y: auto;
}

.whats-new-heading {
    color: #9e85ff;
    text-style: bold;
}

.whats-new-item {
    color: #cbd5e1;
    margin-bottom: 1;
}

#update-divider-line {
    height: 1;
    border-bottom: solid #272e4f;
    margin-bottom: 1;
}

#update-footer-row {
    height: 3;
    layout: horizontal;
    align-vertical: middle;
}

#btn-whats-new {
    width: auto;
    background: transparent;
    border: none;
    color: #9e85ff;
}

#btn-whats-new:hover {
    color: #ffffff;
}

#btn-update-dismiss {
    width: auto;
    background: #272e4f;
    border: solid #9e85ff;
    color: #ffffff;
    text-style: bold;
    margin-left: 2;
}

#btn-update-dismiss:hover {
    background: #9e85ff;
    color: #0b0e1b;
}
