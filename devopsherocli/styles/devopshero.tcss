/* ==========================================================================
   DevOpsHeroCLI - Flocí Cloud Console Architecture & Theme
   Authentic replica of Flocí Local Cloud Runtime Console UI
   ========================================================================== */

Screen {
    background: #090c15;
    color: #f8fafc;
    layout: vertical;
    overflow-x: hidden;
}

/* ==========================================================================
   Root Layout: Left Sidebar + Main Content Area
   ========================================================================== */
#floci-root {
    width: 100%;
    height: 1fr;
    layout: horizontal;
    background: #090c15;
    overflow-x: hidden;
}

/* ==========================================================================
   1. Left Sidebar Navigation (Authentic Flocí Console Sidebar)
   ========================================================================== */
#floci-sidebar {
    width: 25;
    height: 100%;
    background: #070913;
    border-right: solid #141a2e;
    layout: vertical;
    padding: 0;
}

#sidebar-scroll {
    height: 1fr;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 0 1;
}

.sidebar-category {
    color: #475569;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 0;
    height: 1;
}

.sidebar-subcat {
    color: #334155;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 0;
    height: 1;
}

.sidebar-nav-btn {
    width: 100%;
    height: 2;
    min-height: 2;
    background: transparent;
    border: none;
    color: #94a3b8;
    content-align: left middle;
    padding: 0 1;
    margin: 0;
}

.sidebar-nav-btn:hover {
    background: #13192f;
    color: #ffffff;
}

.sidebar-active {
    background: #17213d;
    color: #38bdf8;
    border-left: wide #38bdf8;
    text-style: bold;
}

.sidebar-disabled {
    color: #475569;
}

#sidebar-footer {
    height: 3;
    background: #070913;
    border-top: solid #141a2e;
    layout: horizontal;
    align-vertical: middle;
    padding: 0 1;
}

.sidebar-footer-text {
    width: 1fr;
    color: #475569;
    text-style: bold;
}

.sidebar-footer-collapse {
    width: auto;
    color: #475569;
}

/* ==========================================================================
   2. Main Column (Top Bar + Dynamic View Container)
   ========================================================================== */
#floci-main-col {
    width: 1fr;
    height: 100%;
    layout: vertical;
    background: #090c15;
}

/* Top Header Bar */
#floci-top-header {
    dock: top;
    height: 3;
    background: #0a0d1a;
    border-bottom: solid #141a2e;
    layout: horizontal;
    align-vertical: middle;
    padding: 0 2;
}

#top-title-col {
    width: auto;
    layout: horizontal;
    align-vertical: middle;
}

#top-header-icon {
    width: 3;
    height: 1;
    color: #38bdf8;
    margin-right: 1;
}

#top-header-text-col {
    width: auto;
    layout: horizontal;
    align-vertical: middle;
}

.top-main-title {
    color: #f8fafc;
    text-style: bold;
    margin-right: 2;
}

.top-sub-title {
    color: #64748b;
}

#top-pills-row {
    width: 1fr;
    layout: horizontal;
    align: right middle;
    height: 3;
}

.top-filter-pill {
    width: auto;
    min-width: 0;
    height: 2;
    background: #101528;
    border: solid #1a223b;
    color: #94a3b8;
    padding: 0 1;
    margin-left: 1;
    text-style: bold;
}

.top-filter-pill:hover {
    background: #18223d;
    border: solid #38bdf8;
    color: #ffffff;
}

.top-update-pill {
    display: none;
    width: auto;
    min-width: 0;
    height: 2;
    background: #240a10;
    border: solid #e05236;
    color: #f87171;
    padding: 0 1;
    margin-left: 1;
    text-style: bold;
}

/* Dynamic Views Container */
#floci-views-container {
    height: 1fr;
    overflow-y: auto;
    overflow-x: hidden;
}

/* ==========================================================================
   3. Flocí Console Home View (Dashboard Layout from Screenshot)
   ========================================================================== */
#view-console-home {
    width: 100%;
    height: auto;
    layout: vertical;
    padding: 1 2;
}

/* Selected Runtime Hero Banner Card */
#hero-banner-card {
    width: 100%;
    height: auto;
    background: #11162a;
    border: solid #1a223b;
    border-left: wide #10b981; /* Emerald green left accent line */
    padding: 1 2;
    margin-bottom: 1;
}

#hero-header-row {
    width: 100%;
    height: auto;
    layout: horizontal;
    align-vertical: middle;
}

#hero-text-col {
    width: 1fr;
    layout: vertical;
}

.hero-tag-label {
    color: #10b981;
    text-style: bold;
    height: 1;
}

.hero-main-title {
    color: #f8fafc;
    text-style: bold;
    height: 1;
}

.hero-desc {
    color: #94a3b8;
    height: auto;
    margin-top: 1;
}

.hero-action-btn {
    width: auto;
    min-width: 0;
    height: 3;
    background: #18223d;
    border: solid #38bdf8;
    color: #38bdf8;
    text-style: bold;
    padding: 0 2;
}

.hero-action-btn:hover {
    background: #38bdf8;
    color: #0b0e1b;
}

/* Runtime Status Summary Bar (4 Cards) */
#floci-metrics-row {
    width: 100%;
    height: auto;
    layout: horizontal;
    margin-bottom: 1;
}

.floci-stat-card {
    width: 1fr;
    height: 5;
    background: #11162a;
    border: solid #1a223b;
    padding: 0 1;
    margin-right: 1;
}

.floci-stat-card:last-of-type {
    margin-right: 0;
}

.stat-card-label {
    color: #64748b;
    text-style: bold;
    height: 1;
    margin-top: 0;
}

.stat-card-val {
    color: #f8fafc;
    text-style: bold;
    height: 1;
}

.stat-val-green {
    color: #10b981;
}

.stat-card-sub {
    color: #64748b;
    height: 1;
}

/* Micro Status Chips Row */
#floci-chips-row {
    width: 100%;
    height: auto;
    layout: horizontal;
    margin-bottom: 1;
}

.floci-chip {
    width: auto;
    height: 1;
    background: #0d1120;
    border: solid #192038;
    color: #818cf8;
    padding: 0 1;
    margin-right: 1;
    text-style: bold;
}

/* 4x2 Grid of Service Cards (Flocí Service Cards) */
#floci-grid-container {
    width: 100%;
    height: auto;
    layout: vertical;
}

.floci-grid-row {
    width: 100%;
    height: auto;
    layout: horizontal;
    margin-bottom: 1;
}

.service-card {
    width: 1fr;
    height: 7;
    background: #11172a;
    border: solid #1a223b;
    padding: 1 1;
    margin-right: 1;
    color: #f8fafc;
    content-align: left top;
}

.service-card:last-of-type {
    margin-right: 0;
}

.service-card:hover {
    background: #17213d;
    border: solid #38bdf8;
}

.service-card-disabled {
    opacity: 0.6;
    border: solid #141a2c;
}

/* ==========================================================================
   4. Terminal Lab View (Split into Mission Briefing & Oh My Zsh Terminal)
   ========================================================================== */
#view-terminal-lab {
    width: 100%;
    height: 100%;
    layout: horizontal;
    overflow-x: hidden;
}

/* Left Mission Briefing Panel */
#mission-panel {
    width: 40%;
    height: 100%;
    background: #080a12;
    border-right: solid #141a2e;
    padding: 0 1;
    overflow-y: auto;
    overflow-x: hidden;
}

.mission-track-badge {
    height: auto;
    color: #38bdf8;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 0;
}

.mission-title {
    height: auto;
    color: #ffffff;
    text-style: bold;
    margin-top: 0;
    margin-bottom: 0;
}

.meta-row {
    height: auto;
    layout: horizontal;
    margin-top: 1;
    margin-bottom: 1;
}

.badge-diff {
    height: auto;
    background: #061c12;
    border: round #0d3824;
    color: #10b981;
    padding: 0 1;
    margin-right: 1;
    text-style: bold;
}

.badge-xp {
    height: auto;
    background: #071626;
    border: round #0f3052;
    color: #38bdf8;
    padding: 0 1;
    margin-right: 1;
    text-style: bold;
}

.badge-speed {
    height: auto;
    background: #181205;
    border: round #382c0b;
    color: #fbbf24;
    padding: 0 1;
    text-style: bold;
}

.section-label {
    height: auto;
    color: #64748b;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 0;
}

.context-box {
    height: auto;
    background: #0c101e;
    border: solid #161d33;
    padding: 0 1;
    color: #cbd5e1;
    margin-bottom: 0;
}

.objective-box {
    height: auto;
    background: #081628;
    border: round #00f2fe;
    padding: 0 1;
    color: #ffffff;
    text-style: bold;
    margin-bottom: 0;
}

.rules-box {
    height: auto;
    background: #0c101e;
    border: solid #161d33;
    padding: 0 1;
    color: #94a3b8;
    margin-bottom: 1;
}

.lab-quick-actions {
    layout: horizontal;
    height: auto;
    margin-top: 1;
    margin-bottom: 1;
}

.action-btn {
    width: auto;
    min-width: 0;
    height: 3;
    padding: 0 1;
    margin-right: 1;
    text-style: bold;
}

#btn-tip {
    background: #161205;
    border: round #382c0b;
    color: #fbbf24;
}

#btn-tip:hover {
    background: #2a2008;
    border: round #fbbf24;
    color: #ffffff;
}

#btn-solution {
    background: #18080c;
    border: round #3d141d;
    color: #fb7185;
}

#btn-solution:hover {
    background: #2e0f16;
    border: round #fb7185;
    color: #ffffff;
}

#btn-reset {
    background: #0c0f16;
    border: round #1e2536;
    color: #94a3b8;
}

#btn-reset:hover {
    background: #181f2e;
    border: round #94a3b8;
    color: #ffffff;
}

#btn-tracks {
    background: #071321;
    border: round #143254;
    color: #38bdf8;
}

#btn-tracks:hover {
    background: #0d233d;
    border: round #38bdf8;
    color: #ffffff;
}

.tip-box {
    height: auto;
    background: #191306;
    border: round #fbbf24;
    padding: 0 1;
    margin-top: 1;
    margin-bottom: 0;
    color: #fde68a;
}

.solution-box {
    height: auto;
    background: #1c080d;
    border: round #fb7185;
    padding: 0 1;
    margin-top: 1;
    margin-bottom: 0;
    color: #fecdd3;
}

/* Right Terminal Window (iTerm2 Oh My Zsh) */
#terminal-panel {
    width: 60%;
    height: 100%;
    background: #06070c;
    layout: vertical;
    overflow-x: hidden;
}

#term-title-bar {
    height: 3;
    background: #0a0d1a;
    border-bottom: solid #141a2e;
    padding: 0 1;
    layout: horizontal;
    align-vertical: middle;
    overflow-x: hidden;
}

.term-dots {
    width: 8;
}

.iterm-tab-active {
    width: auto;
    height: 100%;
    background: #0e1322;
    border-top: solid #38bdf8;
    border-left: solid #182035;
    border-right: solid #182035;
    padding: 0 2;
    content-align: center middle;
    align: center middle;
}

.iterm-tab-title {
    color: #e2e8f0;
    text-style: bold;
}

.term-bar-spacer {
    width: 1fr;
}

.term-status-badge {
    width: auto;
    color: #10b981;
    text-style: bold;
    content-align: right middle;
}

#term-output-log {
    height: 1fr;
    background: #06070c;
    color: #f8fafc;
    padding: 0 1;
    overflow-y: auto;
    overflow-x: hidden;
}

#term-input-container {
    height: 3;
    background: #06070c;
    border-top: solid #141a2e;
    layout: horizontal;
    align-vertical: middle;
    padding: 0 1;
    overflow-x: hidden;
}

#term-prompt {
    width: auto;
    color: #10b981;
    text-style: bold;
    padding: 0 1 0 0;
    background: #06070c;
}

#term-input {
    width: 1fr;
    background: #06070c;
    border: none;
    color: #f8fafc;
    padding: 0;
}

#term-input:focus {
    border: none;
    background: #06070c;
}

Input > .input--cursor,
#term-input > .input--cursor {
    background: transparent;
    color: #00f2fe;
    text-style: underline bold;
}

Input > .input--placeholder,
#term-input > .input--placeholder {
    color: #64748b;
}

/* ==========================================================================
   5. Footer Shortcuts Bar
   ========================================================================== */
#footer-bar {
    dock: bottom;
    height: 1;
    background: #070913;
    color: #64748b;
    border-top: solid #141a2e;
    padding: 0 1;
    content-align: center middle;
    overflow-x: hidden;
}

/* ==========================================================================
   6. Modals (TracksModal & AppUpdateModal)
   ========================================================================== */
TracksModal {
    align: center middle;
    background: rgba(4, 5, 8, 0.88);
}

#tracks-dialog {
    width: 82%;
    height: 82%;
    background: #0a0d18;
    border: round #38bdf8;
    padding: 1 2;
    layout: vertical;
}

#tracks-list {
    height: 1fr;
    overflow-y: scroll;
    overflow-x: hidden;
    margin-top: 1;
    margin-bottom: 1;
}

.track-modal-header {
    color: #38bdf8;
    text-style: bold;
}

.track-modal-sub {
    color: #94a3b8;
    margin-bottom: 1;
}

.track-card-btn {
    margin: 0 0 1 0;
    width: 100%;
    height: 5;
    background: #0e1322;
    border: round #1e2844;
    color: #e2e8f0;
    text-align: left;
    padding: 0 1;
}

.track-card-btn:hover {
    background: #16203a;
    border: round #38bdf8;
    color: #ffffff;
}

.track-card-curr {
    background: #0d283d;
    border: round #38bdf8;
    color: #ffffff;
}

.track-card-progress {
    background: #1b1c2b;
    border: round #8b5cf6;
    color: #ffffff;
}

.track-card-done {
    background: #071f15;
    border: round #10b981;
    color: #ffffff;
}

.track-card-locked {
    background: #0d0f17;
    border: round #1b1e2e;
    color: #64748b;
}

#btn-close-modal {
    margin-top: 1;
    background: #141928;
    border: round #27314d;
    color: #cbd5e1;
}

#btn-close-modal:hover {
    background: #1e253c;
    border: round #38bdf8;
    color: #ffffff;
}

/* App Update Modal */
AppUpdateModal {
    align: center middle;
    background: rgba(5, 7, 12, 0.85);
}

#update-card {
    width: 64;
    height: auto;
    max-height: 85%;
    background: #0c101e;
    border: round #38bdf8;
    padding: 1 2;
    layout: vertical;
}

#update-top-row {
    height: 4;
    layout: horizontal;
    align-vertical: middle;
}

#update-icon-box {
    width: 5;
    height: 3;
    content-align: center middle;
    color: #38bdf8;
}

#update-title-col {
    width: 1fr;
    layout: vertical;
}

#update-title-row {
    height: 1;
    layout: horizontal;
}

.update-app-title {
    color: #ffffff;
    text-style: bold;
    margin-right: 1;
}

.update-by-author {
    color: #64748b;
    margin-right: 1;
}

.update-pill-badge {
    background: #38bdf8;
    color: #0b0e1b;
    text-style: bold;
    padding: 0 1;
}

.update-version-label {
    color: #94a3b8;
    margin-top: 1;
}

#btn-update-close {
    width: 4;
    height: 3;
    background: transparent;
    border: none;
    color: #64748b;
}

#btn-update-close:hover {
    color: #ffffff;
}

#update-progress-row {
    height: auto;
    margin-top: 1;
    margin-bottom: 1;
}

.update-status-line {
    height: 1;
    layout: horizontal;
    margin-bottom: 1;
}

#lbl-update-spinner {
    width: 2;
    color: #38bdf8;
}

.update-status-msg {
    color: #94a3b8;
}

#update-progress-bar {
    height: 1;
    background: #141a2e;
    color: #38bdf8;
}

#update-whats-new-box {
    height: auto;
    max-height: 12;
    background: #090c15;
    border: solid #161d33;
    padding: 1 1;
    margin-top: 1;
    margin-bottom: 1;
    overflow-y: auto;
}

.whats-new-heading {
    color: #38bdf8;
    text-style: bold;
}

.whats-new-item {
    color: #cbd5e1;
    margin-bottom: 1;
}

#update-divider-line {
    height: 1;
    border-bottom: solid #161d33;
    margin-bottom: 1;
}

#update-footer-row {
    height: 3;
    layout: horizontal;
    align-vertical: middle;
}

#btn-whats-new {
    width: auto;
    background: transparent;
    border: none;
    color: #38bdf8;
}

#btn-whats-new:hover {
    color: #ffffff;
}

#btn-update-dismiss {
    width: auto;
    background: #18223d;
    border: solid #38bdf8;
    color: #38bdf8;
    text-style: bold;
    margin-left: 2;
}

#btn-update-dismiss:hover {
    background: #38bdf8;
    color: #0b0e1b;
}
