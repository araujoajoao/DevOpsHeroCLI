/* DevOpsHeroCLI - Cyber-Minimalist & Futuristic Bold TUI Theme */

Screen {
    background: #06070a;
    color: #e2e8f0;
    layout: vertical;
    overflow-x: hidden;
}

/* ==========================================================================
   Header Bar (Top HUD)
   ========================================================================== */
#header-bar {
    dock: top;
    height: 4;
    background: #090b10;
    border-bottom: solid #141822;
    padding: 0 1;
    layout: horizontal;
    align-vertical: middle;
    overflow-x: hidden;
}

.brand {
    width: auto;
    color: #00f2fe;
    text-style: bold;
    content-align: left middle;
    margin-right: 2;
}

.level-box {
    width: 15;
    height: auto;
    layout: vertical;
    align-vertical: middle;
    padding: 0;
    margin-right: 2;
}

.level-title {
    color: #00ff87;
    text-style: bold;
    height: 1;
}

.xp-bar-container {
    height: 1;
    background: #11151f;
    color: #00ff87;
}

.streak-box {
    width: auto;
    min-width: 0;
    height: 3;
    content-align: center middle;
    color: #fbbf24;
    text-style: bold;
    background: #130f06;
    border: round #3d2f10;
    padding: 0 1;
    margin-right: 1;
}

.nav-actions {
    layout: horizontal;
    align: right middle;
    width: 1fr;
    overflow-x: hidden;
}

/* Sleek Cyber-Minimalist Action Buttons */
.action-btn {
    width: auto;
    min-width: 0;
    height: 3;
    padding: 0 1;
    margin: 0 0 0 1;
    text-style: bold;
}

#btn-tracks {
    background: #071321;
    border: round #143254;
    color: #38bdf8;
}

#btn-tracks:hover {
    background: #0d233d;
    border: round #38bdf8;
    color: #ffffff;
}

#btn-tip {
    background: #161205;
    border: round #382c0b;
    color: #fbbf24;
}

#btn-tip:hover {
    background: #2a2008;
    border: round #fbbf24;
    color: #ffffff;
}

#btn-solution {
    background: #18080c;
    border: round #3d141d;
    color: #fb7185;
}

#btn-solution:hover {
    background: #2e0f16;
    border: round #fb7185;
    color: #ffffff;
}

#btn-reset {
    background: #0c0f16;
    border: round #1e2536;
    color: #94a3b8;
}

#btn-reset:hover {
    background: #181f2e;
    border: round #94a3b8;
    color: #ffffff;
}

/* ==========================================================================
   Main Split View
   ========================================================================== */
#main-container {
    height: 1fr;
    layout: horizontal;
    overflow-x: hidden;
}

/* Left Mission Panel (Mission Briefing Card) */
#mission-panel {
    width: 42%;
    height: 100%;
    background: #080a0f;
    border-right: solid #141822;
    padding: 0 2;
    overflow-y: auto;
    overflow-x: hidden;
}

.mission-track-badge {
    height: auto;
    color: #00f2fe;
    text-style: bold;
    background: transparent;
    padding: 0;
    margin-top: 1;
    margin-bottom: 0;
    width: auto;
}

.mission-title {
    height: auto;
    color: #ffffff;
    text-style: bold;
    margin-top: 0;
    margin-bottom: 0;
}

.meta-row {
    height: auto;
    layout: horizontal;
    margin-top: 1;
    margin-bottom: 1;
}

.badge-diff {
    height: auto;
    background: #061c12;
    border: round #0d3824;
    color: #00ff87;
    padding: 0 1;
    margin-right: 1;
    text-style: bold;
}

.badge-xp {
    height: auto;
    background: #071626;
    border: round #0f3052;
    color: #38bdf8;
    padding: 0 1;
    margin-right: 1;
    text-style: bold;
}

.badge-speed {
    height: auto;
    background: #181205;
    border: round #382c0b;
    color: #fbbf24;
    padding: 0 1;
    text-style: bold;
}

.section-label {
    height: auto;
    color: #64748b;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 0;
}

.context-box {
    height: auto;
    background: #0b0e14;
    border: solid #161b26;
    padding: 0 1;
    margin-bottom: 0;
    color: #cbd5e1;
}

/* Hero Element: Neon Focused Objective Card */
.objective-box {
    height: auto;
    background: #05141c;
    border: round #00f2fe;
    padding: 0 1;
    margin-bottom: 0;
    color: #ffffff;
    text-style: bold;
}

.rules-box {
    height: auto;
    background: #0b0e14;
    border: solid #161b26;
    padding: 0 1;
    margin-bottom: 1;
    color: #94a3b8;
}

.tip-box {
    height: auto;
    background: #191306;
    border: round #fbbf24;
    padding: 0 1;
    margin-top: 1;
    margin-bottom: 0;
    color: #fde68a;
}

.solution-box {
    height: auto;
    background: #1c080d;
    border: round #fb7185;
    padding: 0 1;
    margin-top: 1;
    margin-bottom: 0;
    color: #fecdd3;
}

/* ==========================================================================
   Right Terminal Panel (Obsidian Cyber-Terminal)
   ========================================================================== */
#terminal-panel {
    width: 58%;
    height: 100%;
    background: #06070a;
    layout: vertical;
    overflow-x: hidden;
}

#term-title-bar {
    height: 3;
    background: #090b10;
    border-bottom: solid #141822;
    padding: 0 1;
    layout: horizontal;
    align-vertical: middle;
    overflow-x: hidden;
}

.term-dots {
    width: 8;
}

.iterm-tab-active {
    width: auto;
    height: 100%;
    background: #0e121a;
    border-top: solid #00f2fe;
    border-left: solid #181d2a;
    border-right: solid #181d2a;
    padding: 0 2;
    content-align: center middle;
    align: center middle;
}

.iterm-tab-title {
    color: #e2e8f0;
    text-style: bold;
}

.term-bar-spacer {
    width: 1fr;
}

.term-status-badge {
    width: auto;
    color: #00ff87;
    text-style: bold;
    content-align: right middle;
}

#term-output-log {
    height: 1fr;
    background: #06070a;
    color: #f8fafc;
    padding: 0 1;
    overflow-y: auto;
    overflow-x: hidden;
}

#term-input-container {
    height: 3;
    background: #06070a;
    border-top: solid #141822;
    layout: horizontal;
    align-vertical: middle;
    padding: 0 1;
    overflow-x: hidden;
}

#term-prompt {
    width: auto;
    color: #00ff87;
    text-style: bold;
    padding: 0 1 0 0;
    background: #06070a;
}

#term-input {
    width: 1fr;
    background: #06070a;
    border: none;
    color: #f8fafc;
    padding: 0;
}

#term-input:focus {
    border: none;
    background: #06070a;
}

#term-input > .input--cursor {
    background: transparent;
    color: #00f2fe;
    text-style: underline bold;
}

/* ==========================================================================
   Footer Shortcuts Bar
   ========================================================================== */
#footer-bar {
    dock: bottom;
    height: 1;
    background: #07090d;
    color: #64748b;
    border-top: solid #141822;
    padding: 0 1;
    content-align: center middle;
    overflow-x: hidden;
}

/* ==========================================================================
   Tracks Modal Dialog (Cyberpunk Glass HUD)
   ========================================================================== */
TracksModal {
    align: center middle;
    background: rgba(4, 5, 8, 0.88);
}

#tracks-dialog {
    width: 82%;
    height: 82%;
    background: #0a0d14;
    border: round #00f2fe;
    padding: 1 2;
    layout: vertical;
}

#tracks-list {
    height: 1fr;
    overflow-y: scroll;
    overflow-x: hidden;
    margin-top: 1;
    margin-bottom: 1;
}

.track-modal-header {
    color: #00f2fe;
    text-style: bold;
}

.track-group-title {
    color: #fbbf24;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 0;
}

.mission-item-btn {
    margin: 0 0 1 0;
    width: 100%;
    height: 3;
    background: #0e121a;
    border: round #1e2536;
    color: #e2e8f0;
    text-align: left;
}

.mission-item-btn:hover {
    background: #161e2e;
    border: round #00f2fe;
    color: #ffffff;
}

.mission-item-done {
    background: #071f14;
    border: round #00ff87;
    color: #00ff87;
}

.mission-item-curr {
    background: #0d283d;
    border: round #38bdf8;
    color: #ffffff;
    text-style: bold;
}

#btn-close-modal {
    width: 100%;
    height: 3;
    background: #240a10;
    border: round #fb7185;
    color: #fb7185;
    text-style: bold;
}

#btn-close-modal:hover {
    background: #3b1019;
    border: round #f43f5e;
    color: #ffffff;
}
