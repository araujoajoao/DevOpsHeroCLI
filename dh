#!/usr/bin/env bash
# dh - DevOpsHeroCLI Universal Zero-Config Launcher
# Works on macOS, Linux, and Windows WSL.
set -e

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"
cd "$DIR"

# 1. Locate suitable Python 3 (3.9+)
PYTHON_BIN=""
for cmd in python3 python; do
    if command -v "$cmd" >/dev/null 2>&1; then
        VER=$("$cmd" -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")' 2>/dev/null || true)
        MAJOR=$(echo "$VER" | cut -d. -f1)
        MINOR=$(echo "$VER" | cut -d. -f2)
        if [ "$MAJOR" -eq 3 ] && [ "$MINOR" -ge 9 ]; then
            PYTHON_BIN="$cmd"
            break
        fi
    fi
done

if [ -z "$PYTHON_BIN" ]; then
    echo -e "\033[1;31m[ERRO]\033[0m Python 3.9 ou superior não foi encontrado no sistema."
    echo ""
    echo "Instale o Python 3:"
    echo "  • macOS (Homebrew):   brew install python3"
    echo "  • Ubuntu / Debian:    sudo apt update && sudo apt install -y python3 python3-venv python3-pip"
    echo "  • Fedora / RHEL:      sudo dnf install -y python3 python3-pip"
    echo "  • Arch Linux:         sudo pacman -S python python-pip"
    echo "  • Windows:            Baixe em https://www.python.org/downloads/"
    exit 1
fi

# 2. Setup Virtual Environment if not present
VENV_DIR="$DIR/.venv"
INSTALL_FLAG="-e"
if [ ! -w "$DIR" ]; then
    VENV_DIR="$HOME/.devopsherocli/venv"
    INSTALL_FLAG=""
    mkdir -p "$HOME/.devopsherocli"
fi

# Recreate the venv when missing or broken (e.g. copied from another machine/OS,
# where bin/python points to an interpreter that does not exist here).
venv_ok() {
    [ -x "$VENV_DIR/bin/python" ] && "$VENV_DIR/bin/python" -c 'import sys' >/dev/null 2>&1
}

if [ ! -d "$VENV_DIR" ] || [ ! -f "$VENV_DIR/bin/pip" ] || ! venv_ok; then
    if [ -d "$VENV_DIR" ]; then
        echo -e "\033[1;33m⚡ [DevOpsHeroCLI]\033[0m Ambiente isolado inválido para este sistema. Recriando..."
    else
        echo -e "\033[1;34m⚡ [DevOpsHeroCLI]\033[0m Primeira execução detectada. Criando ambiente isolado..."
    fi
    if ! "$PYTHON_BIN" -m venv --clear "$VENV_DIR" >/dev/null 2>&1; then
        # Debian/Ubuntu ship Python without ensurepip unless python3-venv is installed.
        if command -v uv >/dev/null 2>&1; then
            rm -rf "$VENV_DIR"
            uv venv --seed --quiet -p "$(command -v "$PYTHON_BIN")" "$VENV_DIR"
        else
            echo -e "\033[1;31m[ERRO]\033[0m Não foi possível criar o ambiente virtual (ensurepip ausente)."
            echo "  • Ubuntu / Debian:    sudo apt install -y python3-venv"
            echo "  • Alternativa:        instale o uv (https://docs.astral.sh/uv/) e rode ./dh novamente"
            exit 1
        fi
    fi
    
    NEEDS_INSTALL=1
fi

# Packaged installs (.deb / .app) live in a read-only directory and are installed
# as a regular (non-editable) package: reinstall whenever the packaged version changes.
SRC_VERSION=$(sed -n 's/^__version__[[:space:]]*=[[:space:]]*["'"'"']\([^"'"'"']*\)["'"'"'].*/\1/p' "$DIR/devopsherocli/__init__.py")
if [ -z "$INSTALL_FLAG" ] && [ -z "${NEEDS_INSTALL:-}" ]; then
    VENV_VERSION=$("$VENV_DIR/bin/python" -I -c 'import devopsherocli; print(devopsherocli.__version__)' 2>/dev/null || true)
    if [ "$VENV_VERSION" != "$SRC_VERSION" ]; then
        echo -e "\033[1;34m⚡ [DevOpsHeroCLI]\033[0m Nova versão instalada (${VENV_VERSION:-?} → $SRC_VERSION). Atualizando ambiente..."
        NEEDS_INSTALL=1
    fi
fi

if [ -n "${NEEDS_INSTALL:-}" ]; then
    echo -e "\033[1;34m⚡ [DevOpsHeroCLI]\033[0m Instalando dependências (Textual, Rich, Prompt Toolkit)..."
    "$VENV_DIR/bin/pip" install --upgrade pip >/dev/null 2>&1 || true
    if [ -n "$INSTALL_FLAG" ]; then
        "$VENV_DIR/bin/pip" install -q -e "$DIR"
    else
        # Build from a private copy: the packaged directory is read-only for the user.
        BUILD_SRC=$(mktemp -d)
        trap 'rm -rf "$BUILD_SRC"' EXIT
        cp -R "$DIR/devopsherocli" "$DIR/pyproject.toml" "$BUILD_SRC/"
        for f in README.md LICENSE; do
            if [ -f "$DIR/$f" ]; then cp "$DIR/$f" "$BUILD_SRC/"; else touch "$BUILD_SRC/$f"; fi
        done
        "$VENV_DIR/bin/pip" install -q --upgrade "$BUILD_SRC"
        rm -rf "$BUILD_SRC"
        trap - EXIT
    fi
    echo -e "\033[1;32m✓ [DevOpsHeroCLI]\033[0m Ambiente configurado com sucesso!"
    echo ""
fi

# 3. Handle explicit update argument directly
if [ "$1" = "update" ] || [ "$1" = "upgrade" ]; then
    echo -e "\033[1;34m⚡ [DevOpsHeroCLI]\033[0m Verificando e baixando atualizações do GitHub..."
    if [ -d "$DIR/.git" ]; then
        git -C "$DIR" pull --ff-only origin main
        echo -e "\033[1;34m⚡ [DevOpsHeroCLI]\033[0m Sincronizando ambiente Python..."
        "$VENV_DIR/bin/pip" install -q -e "$DIR"
        echo -e "\033[1;32m✓ [DevOpsHeroCLI]\033[0m DevOpsHero atualizado com sucesso!"
        exit 0
    else
        echo -e "\033[1;33m[AVISO]\033[0m Diretório .git não encontrado (cópia baixada como ZIP)."
        echo "Para atualizar, baixe o instalador mais recente em:"
        echo "  https://github.com/araujoajoao/DevOpsHeroCLI/releases/latest"
        exit 1
    fi
fi

# 4. Launch application
if [ -f "$VENV_DIR/bin/devopsherocli" ]; then
    exec "$VENV_DIR/bin/devopsherocli" "$@"
else
    exec "$VENV_DIR/bin/python" -m devopsherocli.cli "$@"
fi
